# ============================================================
# AI Interview Platform — Environment Configuration Template
# ============================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# NEVER commit your real .env file to version control.
# ============================================================


# ---- Security -----------------------------------------------
# Generate a strong secret key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# This MUST be set to a unique, random value. The application
# will generate a temporary key (invalidating sessions on restart)
# if SECRET_KEY is absent in development, and will refuse to start
# in production/staging.
SECRET_KEY=REPLACE_WITH_YOUR_GENERATED_SECRET_KEY

# ---- Runtime Environment ------------------------------------
# Controls fail-fast behaviour for secret validation.
# Values: development | staging | production
ENVIRONMENT=development

# ---- CORS ---------------------------------------------------
# Comma-separated list of allowed frontend origins.
# Leave blank in development to use localhost defaults.
# In production, set this to your actual frontend URL(s):
#   ALLOWED_ORIGINS=https://yourapp.com,https://www.yourapp.com
ALLOWED_ORIGINS=

# ---- AI Service Configuration --------------------------------
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.5-flash
AI_ENABLED=true
AI_FALLBACK_TO_MOCK=true
